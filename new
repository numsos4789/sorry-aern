<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>For My Special One ❤️</title>
    <!-- โหลดฟอนต์ Google Fonts สวยๆ -->
    <link href="https://fonts.googleapis.com/css2?family=Mitr:wght@300;400;600&family=Sarabun:wght@300;400;600&display=swap" rel="stylesheet">
    
    <style>
        :root {
            --primary: #ff4b6e;
            --secondary: #ff85a2;
            --bg-color: #fff0f3;
            --card-bg: #ffffff;
            --text-color: #4a4a4a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Mitr', 'Sarabun', sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            overflow-x: hidden;
            padding-bottom: 50px;
        }

        /* ---------------- Background Animation (หัวใจลอย) ---------------- */
        .bg-hearts {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
            overflow: hidden;
        }

        .floating-heart {
            position: absolute;
            font-size: 20px;
            color: rgba(255, 75, 110, 0.4);
            animation: floatUp 8s linear infinite;
        }

        @keyframes floatUp {
            0% {
                transform: translateY(100vh) scale(0.5) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(-10vh) scale(1.2) rotate(360deg);
                opacity: 0;
            }
        }

        /* ---------------- Main Container ---------------- */
        .container {
            max-width: 800px;
            margin: 40px auto;
            padding: 20px;
        }

        /* ---------------- Hero Section ---------------- */
        .hero-card {
            background: var(--card-bg);
            border-radius: 25px;
            padding: 30px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(255, 75, 110, 0.15);
            animation: fadeIn 1.2s ease-in-out;
            margin-bottom: 40px;
        }

        .profile-img-container {
            position: relative;
            width: 180px;
            height: 180px;
            margin: 0 auto 20px;
        }

        .profile-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            border: 5px solid var(--secondary);
            box-shadow: 0 8px 20px rgba(0,0,0,0.1);
        }

        .beating-heart {
            position: absolute;
            bottom: 5px;
            right: 5px;
            font-size: 32px;
            animation: beat 1.2s infinite;
        }

        @keyframes beat {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.3); }
        }

        h1 {
            color: var(--primary);
            font-size: 2rem;
            margin-bottom: 10px;
        }

        .subtitle {
            color: #777;
            font-weight: 300;
            margin-bottom: 20px;
        }

        /* ---------------- Counter Badge ---------------- */
        .counter-badge {
            display: inline-block;
            background: linear-gradient(135deg, var(--primary), var(--secondary));
            color: white;
            padding: 10px 25px;
            border-radius: 50px;
            font-size: 1.1rem;
            box-shadow: 0 4px 15px rgba(255, 75, 110, 0.3);
            margin-bottom: 10px;
        }

        /* ---------------- Gallery Section (10 รูป) ---------------- */
        .gallery-title {
            text-align: center;
            color: var(--primary);
            margin: 40px 0 20px;
            font-size: 1.5rem;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
        }

        .gallery-item {
            position: relative;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 15px rgba(0,0,0,0.08);
            aspect-ratio: 1 / 1;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            background: #eee;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.5s ease;
        }

        .gallery-item:hover {
            transform: translateY(-8px) scale(1.03);
            box-shadow: 0 12px 25px rgba(255, 75, 110, 0.25);
        }

        .gallery-item:hover img {
            transform: scale(1.1);
        }

        /* ---------------- Interactive Secret Message ---------------- */
        .secret-box {
            background: var(--card-bg);
            border-radius: 20px;
            padding: 30px;
            margin-top: 40px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        }

        .btn-toggle {
            background: var(--primary);
            color: white;
            border: none;
            padding: 12px 30px;
            font-size: 1.1rem;
            font-family: inherit;
            border-radius: 50px;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(255, 75, 110, 0.4);
        }

        .btn-toggle:hover {
            background: #e03e5e;
            transform: scale(1.05);
        }

        .secret-content {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.8s ease-in-out, opacity 0.8s ease-in-out;
            opacity: 0;
            margin-top: 0;
        }

        .secret-content.show {
            max-height: 500px;
            opacity: 1;
            margin-top: 25px;
        }

        .letter-text {
            font-size: 1.05rem;
            line-height: 1.8;
            color: #555;
            text-align: left;
            background: #fff8f9;
            padding: 20px;
            border-left: 4px solid var(--primary);
            border-radius: 8px;
        }

        /* ---------------- Animations ---------------- */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ---------------- Responsive ---------------- */
        @media (max-width: 600px) {
            .gallery-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            h1 { font-size: 1.6rem; }
        }
    </style>
</head>
<body>

    <!-- Background Hearts -->
    <div class="bg-hearts" id="bgHearts"></div>

    <div class="container">
        <!-- Hero Section -->
        <div class="hero-card">
            <div class="profile-img-container">
                <!-- ใส่รูปคู่หลักของคุณที่นี่ -->
                <img src="https://images.unsplash.com/photo-1518199266791-5375a83190b7?w=500" alt="Our Main Picture" class="profile-img">
                <div class="beating-heart">💖</div>
            </div>
            <h1>Happy Anniversary!</h1>
            <p class="subtitle">ขอบคุณสำหรับทุกๆ รอยยิ้มและความทรงจำดีๆ นะครับ</p>
            
            <div class="counter-badge">
                คบกันมาแล้ว <span id="daysCounter">0</span> วันแล้วนะ 🥰
            </div>
        </div>

        <!-- Photo Gallery (10 รูป) -->
        <h2 class="gallery-title">📸 ความทรงจำของเรา (10 Moments)</h2>
        <div class="gallery-grid">
            <!-- รูปที่ 1 -->
            <div class="gallery-item">
                <img src="https://picsum.photos/400/400?random=1" alt="Memory 1">
            </div>
            <!-- รูปที่ 2 -->
            <div class="gallery-item">
                <img src="https://picsum.photos/400/400?random=2" alt="Memory 2">
            </div>
            <!-- รูปที่ 3 -->
            <div class="gallery-item">
                <img src="https://picsum.photos/400/400?random=3" alt="Memory 3">
            </div>
            <!-- รูปที่ 4 -->
            <div class="gallery-item">
                <img src="https://picsum.photos/400/400?random=4" alt="Memory 4">
            </div>
            <!-- รูปที่ 5 -->
            <div class="gallery-item">
                <img src="https://picsum.photos/400/400?random=5" alt="Memory 5">
            </div>
            <!-- รูปที่ 6 -->
            <div class="gallery-item">
                <img src="https://picsum.photos/400/400?random=6" alt="Memory 6">
            </div>
            <!-- รูปที่ 7 -->
            <div class="gallery-item">
                <img src="https://picsum.photos/400/400?random=7" alt="Memory 7">
            </div>
            <!-- รูปที่ 8 -->
            <div class="gallery-item">
                <img src="https://picsum.photos/400/400?random=8" alt="Memory 8">
            </div>
            <!-- รูปที่ 9 -->
            <div class="gallery-item">
                <img src="https://picsum.photos/400/400?random=9" alt="Memory 9">
            </div>
            <!-- รูปที่ 10 -->
            <div class="gallery-item">
                <img src="https://picsum.photos/400/400?random=10" alt="Memory 10">
            </div>
        </div>

        <!-- Secret Letter Box -->
        <div class="secret-box">
            <button class="btn-toggle" onclick="toggleSecret()">💌 กดเพื่อเปิดจดหมายลับ</button>
            <div class="secret-content" id="secretLetter">
                <div class="letter-text">
                    ถึงเธอคนเก่ง... ❤️<br><br>
                    ตั้งแต่วันแรกที่เราได้เจอกัน ชีวิตเค้าก็มีความสุขและมีรอยยิ้มเพิ่มขึ้นมากๆ เลยนะ 
                    ขอบคุณที่ค่อยเคียงข้างกัน คอยซัพพอร์ต และน่ารักกับเค้าเสมอมา <br><br>
                    รูปภาพข้างบนอาจเป็นแค่ส่วนหนึ่งของความทรงจำ แต่ทุกๆ วินาทีที่มีเธออยู่มันมีความหมายมากจริงๆ 
                    รักเธอที่สุดเลยนะครับ! 💕
                </div>
            </div>
        </div>
    </div>

    <script>
        // 1. ระบบคำนวณจำนวนวันที่คบกัน (เปลี่ยนวันที่เริ่มต้นตรงนี้)
        const startDate = new Date('2023-01-01'); // ** เปลี่ยนเป็น ปี-เดือน-วัน ที่เริ่มคบกัน **
        const today = new Date();
        const diffTime = Math.abs(today - startDate);
        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        document.getElementById('daysCounter').innerText = diffDays;

        // 2. ระบบสร้างหัวใจลอย Background
        const heartContainer = document.getElementById('bgHearts');
        const hearts = ['❤️', '💖', '🌸', '✨', '💕'];

        function createHeart() {
            const heart = document.createElement('div');
            heart.classList.add('floating-heart');
            heart.innerText = hearts[Math.floor(Math.random() * hearts.length)];
            heart.style.left = Math.random() * 100 + 'vw';
            heart.style.animationDuration = (Math.random() * 3 + 5) + 's';
            heart.style.fontSize = (Math.random() * 15 + 15) + 'px';
            
            heartContainer.appendChild(heart);

            setTimeout(() => {
                heart.remove();
            }, 8000);
        }

        setInterval(createHeart, 500);

        // 3. ระบบเปิด/ปิด จดหมายลับ
        function toggleSecret() {
            const letter = document.getElementById('secretLetter');
            letter.classList.toggle('show');
        }
    </script>
</body>
</html>
